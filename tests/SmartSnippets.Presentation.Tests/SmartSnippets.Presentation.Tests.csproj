<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\SmartSnippets.Core.Tests\Porting\Fixtures\*.json" Link="Porting\Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Source contracts only: inspect layout without referencing WinUI or compiling App on Linux. -->
    <None Include="..\..\src\SmartSnippets.App\**\*.xaml" Exclude="..\..\src\SmartSnippets.App\obj\**;..\..\src\SmartSnippets.App\bin\**" Link="UiContracts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SmartSnippets.Presentation\SmartSnippets.Presentation.csproj" />
  </ItemGroup>
</Project>
