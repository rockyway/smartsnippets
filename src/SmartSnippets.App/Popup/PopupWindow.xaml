<Window
    x:Class="SmartSnippets.App.Popup.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SmartSnippets">
    <Grid x:Name="RootGrid" Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox
            x:Name="SearchBox"
            PlaceholderText="Search snippets"
            KeyDown="OnKeyDown" />
        <ListView
            x:Name="ResultsList"
            Grid.Row="1"
            IsItemClickEnabled="True"
            SelectionMode="Single"
            ItemClick="OnItemClick"
            KeyDown="OnKeyDown">
            <ListViewItem Content="Insert test string" />
        </ListView>
    </Grid>
</Window>
