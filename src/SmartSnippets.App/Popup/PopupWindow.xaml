<Window
    x:Class="SmartSnippets.App.Popup.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:SmartSnippets.App.Controls"
    xmlns:converters="using:SmartSnippets.App.Converters"
    xmlns:vm="using:SmartSnippets.Presentation.ViewModels"
    Title="Smart Snippets popup">
    <Grid x:Name="RootGrid" Padding="12" KeyDown="OnKeyDown">
        <Border x:Name="SelectedPalette" Background="{ThemeResource AccentTintBrush}" BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}" Visibility="Collapsed"/>
        <ContentControl IsEnabled="{x:Bind ViewModel.IsEditorClosed, Mode=OneWay}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <Grid RowSpacing="8">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Grid.Column="0" automation:AutomationProperties.AutomationId="PopupSearch" automation:AutomationProperties.Name="Search snippets" PlaceholderText="Search label, text, folder, or tag" Text="{x:Bind ViewModel.Query, Mode=OneWay}" TextChanged="OnSearchChanged" />
                <ToggleButton Grid.Column="1" automation:AutomationProperties.AutomationId="PopupLayoutButton" automation:AutomationProperties.Name="Toggle layout" ToolTipService.ToolTip="{x:Bind ViewModel.LayoutTooltip, Mode=OneWay}" IsChecked="{x:Bind ViewModel.IsFolderLayout, Mode=OneWay}" Command="{x:Bind ViewModel.ToggleLayoutCommand, Mode=OneWay}"><FontIcon Glyph="&#xE8FD;" /></ToggleButton>
                <Button x:Name="SortButton" Grid.Column="2" automation:AutomationProperties.AutomationId="PopupSortButton" automation:AutomationProperties.Name="Sort" ToolTipService.ToolTip="{x:Bind ViewModel.SortTooltip, Mode=OneWay}" Click="OnSortClick"><FontIcon Glyph="&#xE8CB;" />
                    <Button.Flyout><MenuFlyout x:Name="SortFlyout" ShouldConstrainToRootBounds="True"><RadioMenuFlyoutItem x:Name="SortLast" Text="Last used" Click="OnSortLast"/><RadioMenuFlyoutItem x:Name="SortUsage" Text="Usage count" Click="OnSortUsage"/><RadioMenuFlyoutItem x:Name="SortCreated" Text="Created date" Click="OnSortCreated"/><RadioMenuFlyoutItem x:Name="SortUpdated" Text="Updated date" Click="OnSortUpdated"/></MenuFlyout></Button.Flyout>
                </Button>
                <Button Grid.Column="3" automation:AutomationProperties.AutomationId="PopupAddButton" automation:AutomationProperties.Name="Add snippet" ToolTipService.ToolTip="Add snippet" Command="{x:Bind ViewModel.AddSnippetCommand, Mode=OneWay}"><FontIcon Glyph="&#xE710;" /></Button>
                <Button Grid.Column="4" automation:AutomationProperties.AutomationId="PopupOpenMainButton" automation:AutomationProperties.Name="Open main window" ToolTipService.ToolTip="Open main window" Command="{x:Bind ViewModel.OpenMainWindowCommand, Mode=OneWay}"><FontIcon Glyph="&#xE8A7;" /></Button>
            </Grid>
            <Grid Grid.Row="1">
                <ListView x:Name="PopupList" automation:AutomationProperties.AutomationId="PopupList" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedIndex, Mode=TwoWay}" IsItemClickEnabled="True" ItemClick="OnItemClick" SelectionChanged="OnSelectionChanged" ContainerContentChanging="OnContainerContentChanging">
                    <ListView.ItemTemplate><DataTemplate x:DataType="vm:PopupItemViewModel"><controls:PopupRow Item="{x:Bind}"/></DataTemplate></ListView.ItemTemplate>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{x:Bind Show(ViewModel.IsEmpty), Mode=OneWay}"><TextBlock Text="{x:Bind ViewModel.EmptyTitle}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.EmptyBody}" TextWrapping="Wrap"/></StackPanel>
            </Grid>
            <StackPanel Grid.Row="2" Spacing="4">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind ViewModel.HintText, Mode=OneWay}"/><TextBlock Grid.Column="1" automation:AutomationProperties.AutomationId="PopupCount" Text="{x:Bind ViewModel.CountText, Mode=OneWay}"/></Grid>
                <InfoBar IsOpen="{x:Bind ViewModel.HasFooterMessage, Mode=OneWay}" IsClosable="False" Severity="{x:Bind FooterSeverity(ViewModel.FooterState), Mode=OneWay}"><StackPanel Spacing="4"><TextBlock automation:AutomationProperties.AutomationId="PopupFooterError" automation:AutomationProperties.LiveSetting="Assertive" automation:AutomationProperties.ItemStatus="{x:Bind ViewModel.FooterItemStatus, Mode=OneWay}" Text="{x:Bind ViewModel.FooterMessage, Mode=OneWay}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="6"><Button automation:AutomationProperties.AutomationId="PopupCopyText" Content="Copy text" Visibility="{x:Bind Show(ViewModel.CanCopyFailedText), Mode=OneWay}" Command="{x:Bind ViewModel.CopyFailedTextCommand, Mode=OneWay}"/><Button automation:AutomationProperties.AutomationId="PopupRestartAdmin" Content="Restart as administrator" Visibility="{x:Bind Show(ViewModel.CanRestartAsAdmin), Mode=OneWay}" Command="{x:Bind ViewModel.RestartAsAdminCommand, Mode=OneWay}"/><Button x:Name="PasteAnywayButton" automation:AutomationProperties.AutomationId="PopupPasteAnyway" Content="Paste anyway" Visibility="{x:Bind Show(ViewModel.IsConfirmingClipboardLoss), Mode=OneWay}" Command="{x:Bind ViewModel.PasteAnywayCommand, Mode=OneWay}"/><Button automation:AutomationProperties.AutomationId="PopupPasteCancel" Content="Cancel" Visibility="{x:Bind Show(ViewModel.IsConfirmingClipboardLoss), Mode=OneWay}" Command="{x:Bind ViewModel.CancelPasteAnywayCommand, Mode=OneWay}"/><Button automation:AutomationProperties.AutomationId="PopupDismiss" Content="Dismiss" Visibility="{x:Bind Show(ViewModel.CanDismissFooter), Mode=OneWay}" Command="{x:Bind ViewModel.DismissFooterCommand, Mode=OneWay}"/></StackPanel></StackPanel></InfoBar>
            </StackPanel>
        </Grid>
        </ContentControl>
        <Grid x:Name="EditorOverlay" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Visibility="{x:Bind Show(ViewModel.IsEditorOpen), Mode=OneWay}" PreviewKeyDown="OnEditorPreviewKeyDown" automation:AutomationProperties.AutomationId="PopupEditor">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Add snippet" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{x:Bind ViewModel.EditorTargetLine, Mode=OneWay}"/></StackPanel>
            <controls:SnippetEditor x:Name="EditorControl" Grid.Row="1" IsCompact="True" ViewModel="{x:Bind ViewModel.Editor, Mode=OneWay}" TextSize="{x:Bind TextSize}" EscapePressed="OnEditorEscape"/>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ctrl+Enter saves" VerticalAlignment="Center"/><Button Grid.Column="1" automation:AutomationProperties.AutomationId="PopupEditorCancel" Content="Cancel" Click="OnEditorCancel"/><Button Grid.Column="2" automation:AutomationProperties.AutomationId="PopupEditorSave" Content="Save" Click="OnEditorSave"/></Grid>
        </Grid>
    </Grid>
</Window>
