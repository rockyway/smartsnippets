<UserControl
    x:Class="SmartSnippets.App.Controls.ShortcutRecorder"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    MinWidth="220"
    HorizontalAlignment="Left"
    automation:AutomationProperties.Name="Shortcut, press keys">
    <Border
        MinHeight="32"
        Padding="10,5"
        Background="{ThemeResource TextControlBackground}"
        BorderBrush="{ThemeResource TextControlBorderBrush}"
        BorderThickness="1"
        CornerRadius="{ThemeResource ControlCornerRadius}">
        <TextBlock
            x:Name="DisplayBlock"
            VerticalAlignment="Center"
            TextTrimming="CharacterEllipsis" />
    </Border>
</UserControl>
