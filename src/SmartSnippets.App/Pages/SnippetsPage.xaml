<Page
    x:Class="SmartSnippets.App.Pages.SnippetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:SmartSnippets.App.Controls"
    xmlns:conv="using:SmartSnippets.App.Converters"
    xmlns:vm="using:SmartSnippets.Presentation.ViewModels"
    Loaded="OnLoaded" KeyboardAcceleratorPlacementMode="Hidden">
    <Page.Resources>
        <conv:BrowseKindToVisibilityConverter x:Key="FolderDotVisible" />

        <!-- Shared by the Browse ListView (wide) and the Browse ComboBox (narrow). -->
        <DataTemplate x:Key="BrowseItemTemplate" x:DataType="vm:BrowseItemViewModel">
            <Grid MinHeight="32" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    Grid.Column="0"
                    Width="8"
                    Height="8"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource FolderTintBrush}"
                    Visibility="{x:Bind Kind, Converter={StaticResource FolderDotVisible}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Count}" />
            </Grid>
        </DataTemplate>

        <Style x:Key="StretchItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource SnippetListItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="OnNewAccelerator" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindAccelerator" />
    </Page.KeyboardAccelerators>

    <!-- Wide/narrow follows the page's own width (code-behind), not the window's: the nav pane takes part of the window. -->
    <Grid x:Name="Root" SizeChanged="OnRootSizeChanged">

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="BrowseColumn" Width="200" />
            <ColumnDefinition x:Name="ListColumn" Width="320" />
            <ColumnDefinition x:Name="EditorColumn" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Browse pane (wide only) -->
        <Grid
            x:Name="BrowsePane"
            Grid.Column="0"
            Padding="8,12"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10,0,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="Browse" />
                <Button
                    Grid.Column="1"
                    Padding="6,4"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnBrowseNewFolderClick"
                    ToolTipService.ToolTip="Add folder"
                    automation:AutomationProperties.Name="Add folder">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
            </Grid>

            <!-- Quick-add folder: Enter creates, Esc cancels. -->
            <StackPanel
                Grid.Row="1"
                Margin="2,0,2,4"
                Spacing="4"
                Visibility="{x:Bind Show(ViewModel.List.IsCreatingFolder), Mode=OneWay}">
                <TextBox
                    x:Name="BrowseNewFolderBox"
                    KeyDown="OnBrowseNewFolderKeyDown"
                    PlaceholderText="Folder name"
                    Text="{x:Bind ViewModel.List.NewFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    automation:AutomationProperties.Name="Add folder name" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.List.NewFolderError, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind HasText(ViewModel.List.NewFolderError), Mode=OneWay}"
                    automation:AutomationProperties.LiveSetting="Assertive" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.List.CancelNewFolderCommand, Mode=OneWay}" Content="Cancel" />
                    <Button
                        Command="{x:Bind ViewModel.List.CreateFolderCommand, Mode=OneWay}"
                        Content="Create"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <ListView
                x:Name="BrowseList"
                Grid.Row="2"
                ItemContainerStyle="{StaticResource StretchItemStyle}"
                ItemTemplate="{StaticResource BrowseItemTemplate}"
                ItemsSource="{x:Bind ViewModel.List.BrowseItems, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.List.SelectedBrowse, Mode=TwoWay}"
                SelectionMode="Single"
                automation:AutomationProperties.Name="Browse" />
        </Grid>

        <!-- List pane -->
        <Grid
            x:Name="ListPane"
            Grid.Column="1"
            Padding="10,12,10,0"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Narrow: the Browse pane collapses into this drop-down. -->
            <ComboBox
                x:Name="BrowseCombo"
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource BrowseItemTemplate}"
                ItemsSource="{x:Bind ViewModel.List.BrowseItems, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.List.SelectedBrowse, Mode=TwoWay}"
                Visibility="Collapsed"
                automation:AutomationProperties.Name="Browse" />

            <Grid Grid.Row="1" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="0"
                    PlaceholderText="Search"
                    Text="{x:Bind ViewModel.List.Query, Mode=OneWay}"
                    TextChanged="OnSearchChanged"
                    KeyDown="OnSearchKeyDown"
                    ToolTipService.ToolTip="Search label, text, tags and folder (Ctrl+F)"
                    automation:AutomationProperties.Name="Search snippets" />
                <Button
                    x:Name="SortButton"
                    Grid.Column="1"
                    Click="OnSortClick"
                    ToolTipService.ToolTip="{x:Bind ViewModel.List.SortTooltip, Mode=OneWay}"
                    automation:AutomationProperties.AutomationId="SnippetsSortButton"
                    automation:AutomationProperties.Name="Sort">
                    <FontIcon FontSize="14" Glyph="&#xE8CB;" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="SortFlyout" ShouldConstrainToRootBounds="True" MenuFlyoutPresenterStyle="{StaticResource SolidMenuFlyoutPresenterStyle}">
                            <RadioMenuFlyoutItem x:Name="SortLast" Text="{x:Bind LastUsedText}" Click="OnSortLast" />
                            <RadioMenuFlyoutItem x:Name="SortUsage" Text="{x:Bind UsageCountText}" Click="OnSortUsage" />
                            <RadioMenuFlyoutItem x:Name="SortCreated" Text="{x:Bind CreatedText}" Click="OnSortCreated" />
                            <RadioMenuFlyoutItem x:Name="SortUpdated" Text="{x:Bind UpdatedText}" Click="OnSortUpdated" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button
                    Grid.Column="2"
                    Command="{x:Bind ViewModel.NewCommand, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="New snippet (Ctrl+N)"
                    automation:AutomationProperties.Name="New snippet">
                    <FontIcon FontSize="14" Glyph="&#xE710;" />
                </Button>
                <Button Grid.Column="3"
                    Command="{x:Bind ViewModel.Porting.ImportCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Import snippets from Smart Snippets, TermFlow, Rephlo or InkSpoke (.json)"
                    automation:AutomationProperties.AutomationId="ImportSnippetsButton"
                    automation:AutomationProperties.Name="Import snippets">
                    <FontIcon FontSize="14" Glyph="{x:Bind ImportGlyph}" />
                </Button>
                <Button Grid.Column="4"
                    Command="{x:Bind ViewModel.Porting.ExportCommand, Mode=OneWay}"
                    ToolTipService.ToolTip="Export all snippets and folders to a .json file"
                    automation:AutomationProperties.AutomationId="ExportSnippetsButton"
                    automation:AutomationProperties.Name="Export snippets">
                    <FontIcon FontSize="14" Glyph="{x:Bind ExportGlyph}" />
                </Button>
            </Grid>

            <Grid Grid.Row="2">
                <ListView
                    x:Name="SnippetList"
                    FontSize="{x:Bind TextSize.FontSize, Mode=OneWay, FallbackValue=14}"
                    IsItemClickEnabled="True"
                    ContainerContentChanging="OnSnippetContainerContentChanging"
                    ItemClick="OnItemClick"
                    ItemContainerStyle="{StaticResource StretchItemStyle}"
                    ItemsSource="{x:Bind ViewModel.List.Items, Mode=OneWay}"
                    KeyDown="OnListKeyDown"
                    SelectedItem="{x:Bind ViewModel.List.SelectedItem, Mode=TwoWay}"
                    SelectionMode="Single"
                    automation:AutomationProperties.Name="Snippets">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SnippetRowViewModel">
                            <controls:SnippetRowDetails Label="{x:Bind Label}" FolderName="{x:Bind FolderName}"
                                TagsDisplay="{x:Bind TagsDisplay}" ContentText="{x:Bind ContentText}" TextSize="{x:Bind TextSize}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Margin="8,12"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.List.EmptyState, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind Show(ViewModel.List.IsEmpty), Mode=OneWay}" />
            </Grid>
        </Grid>

        <!-- Editor pane -->
        <Grid
            x:Name="EditorPane"
            Grid.Column="2"
            Padding="20,16"
            RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Row="0"
                Click="OnBackClick"
                Content="Back to list"
                ToolTipService.ToolTip="Back to the snippet list"
                Visibility="Collapsed"
                automation:AutomationProperties.Name="Back to list" />

            <controls:SnippetEditor
                x:Name="EditorControl"
                Grid.Row="1"
                Visibility="{x:Bind Show(ViewModel.HasEditor), Mode=OneWay}" />
            <TextBlock
                Grid.Row="1"
                Margin="8,12"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EditorEmptyMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind Hide(ViewModel.HasEditor), Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
