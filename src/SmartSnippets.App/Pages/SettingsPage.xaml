<Page
    x:Class="SmartSnippets.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:controls="using:SmartSnippets.App.Controls">
    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Padding="24"
            HorizontalAlignment="Left"
            Spacing="12">
            <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="Settings" />

            <InfoBar
                x:Name="StatusBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsStatusVisible, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ToInfoBarSeverity(ViewModel.StatusSeverity), Mode=OneWay}" />

            <TextBlock Margin="0,12,0,0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Appearance" />
            <RadioButtons
                x:Name="ThemeRadios"
                automation:AutomationProperties.Name="Theme"
                Header="Theme"
                SelectedIndex="{x:Bind ThemeToIndex(ViewModel.SelectedTheme), Mode=OneWay}"
                SelectionChanged="OnThemeSelectionChanged">
                <x:String>System</x:String>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
            </RadioButtons>
            <RadioButtons
                x:Name="TextSizeRadios"
                automation:AutomationProperties.Name="Text size"
                Header="Text size"
                SelectedIndex="{x:Bind TextSizeToIndex(ViewModel.SelectedTextSizePreset), Mode=OneWay}"
                SelectionChanged="OnTextSizeSelectionChanged">
                <x:String>Small (12)</x:String>
                <x:String>Medium (14)</x:String>
                <x:String>Large (18)</x:String>
                <x:String>Custom</x:String>
            </RadioButtons>
            <NumberBox
                x:Name="CustomSizeBox"
                Width="160"
                HorizontalAlignment="Left"
                automation:AutomationProperties.Name="Custom text size"
                Header="Custom size (10 to 32)"
                IsEnabled="{x:Bind ViewModel.IsCustomTextSize, Mode=OneWay}"
                Maximum="32"
                Minimum="10"
                SpinButtonPlacementMode="Inline"
                ValidationMode="InvalidInputOverwritten"
                Value="{x:Bind ViewModel.CustomTextSize, Mode=TwoWay}" />
            <TextBlock
                automation:AutomationProperties.Name="Text size preview"
                FontSize="{x:Bind ViewModel.TextSize.FontSize, Mode=OneWay}"
                Text="Preview: the quick brown fox jumps over the lazy dog"
                TextWrapping="Wrap" />

            <TextBlock Margin="0,12,0,0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Startup" />
            <ToggleSwitch
                x:Name="StartupToggle"
                automation:AutomationProperties.Name="Start at login"
                Header="Start at login"
                IsOn="{x:Bind ViewModel.StartAtLogin, Mode=OneWay}"
                Toggled="OnStartupToggled" />

            <TextBlock Margin="0,12,0,0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Shortcut" />
            <InfoBar
                x:Name="HotkeyBanner"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsHotkeyBannerVisible, Mode=OneWay}"
                Message="{x:Bind ViewModel.HotkeyStatusMessage, Mode=OneWay}"
                Severity="Warning"
                Title="The shortcut is not active" />
            <TextBlock>
                <Run Text="Current shortcut:" />
                <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.CurrentHotkeyDisplay, Mode=OneWay}" />
            </TextBlock>
            <controls:ShortcutRecorder
                x:Name="Recorder"
                Cleared="OnRecorderCleared"
                DisplayText="{x:Bind ViewModel.CandidateDisplay, Mode=OneWay}"
                GestureCaptured="OnGestureCaptured" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    automation:AutomationProperties.Name="Apply shortcut"
                    Command="{x:Bind ViewModel.ApplyHotkeyCommand}"
                    Content="Apply" />
                <Button
                    automation:AutomationProperties.Name="Restore default shortcut"
                    Command="{x:Bind ViewModel.RestoreDefaultHotkeyCommand}"
                    Content="Restore default (Ctrl+Shift+Space)" />
            </StackPanel>

            <TextBlock Margin="0,12,0,0" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Advanced" />
            <Button
                automation:AutomationProperties.Name="Restart as administrator"
                Command="{x:Bind ViewModel.RestartAsAdministratorCommand}"
                Content="Restart as administrator"
                IsEnabled="{x:Bind ViewModel.CanRestartAsAdmin, Mode=OneTime}" />
            <TextBlock
                Opacity="0.7"
                Text="Needed to insert text into windows running as administrator."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
