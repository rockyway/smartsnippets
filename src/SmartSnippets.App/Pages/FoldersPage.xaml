<Page
    x:Class="SmartSnippets.App.Pages.FoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:automation="using:Microsoft.UI.Xaml.Automation"
    xmlns:conv="using:SmartSnippets.App.Converters"
    xmlns:vm="using:SmartSnippets.Presentation.ViewModels">
    <Page.Resources>
        <conv:InvertedBoolToVisibilityConverter x:Key="NotVisible" />
        <conv:NonEmptyToVisibilityConverter x:Key="HasTextVisible" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{ThemeResource TitleTextBlockStyle}" Text="Folders" />

        <Grid
            Grid.Row="1"
            MaxWidth="560"
            HorizontalAlignment="Stretch"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                KeyDown="OnNewFolderKeyDown"
                PlaceholderText="New folder name"
                Text="{x:Bind ViewModel.NewFolderName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                automation:AutomationProperties.Name="New folder name" />
            <Button
                Grid.Column="1"
                Command="{x:Bind ViewModel.CreateCommand, Mode=OneWay}"
                Content="Create"
                ToolTipService.ToolTip="Create folder"
                automation:AutomationProperties.Name="Create folder" />
        </Grid>

        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Text="{x:Bind ViewModel.NewFolderError, Mode=OneWay}"
            TextWrapping="Wrap"
            Visibility="{x:Bind ViewModel.NewFolderError, Mode=OneWay, Converter={StaticResource HasTextVisible}}"
            automation:AutomationProperties.LiveSetting="Assertive" />

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left" Spacing="8">
            <ListView
                x:Name="FolderList"
                HorizontalAlignment="Stretch"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Hidden"
                FontSize="{x:Bind TextSize.FontSize, Mode=OneWay, FallbackValue=14}"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                SelectionMode="None"
                automation:AutomationProperties.Name="Folders">
                <ListView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderRowViewModel">
                        <Grid MinHeight="48" Padding="0,4">
                            <!-- Normal row -->
                            <Grid
                                ColumnSpacing="8"
                                Visibility="{x:Bind IsRenaming, Mode=OneWay, Converter={StaticResource NotVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Opacity="0.7"
                                    Text="{x:Bind SnippetCountDisplay, Mode=OneWay}" />
                                <Button
                                    Grid.Column="2"
                                    Click="OnRenameClick"
                                    Content="Rename"
                                    Visibility="{x:Bind CanEdit}"
                                    ToolTipService.ToolTip="Rename folder"
                                    automation:AutomationProperties.Name="Rename folder" />
                                <Button
                                    Grid.Column="3"
                                    Click="OnDeleteClick"
                                    Content="Delete"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Visibility="{x:Bind CanEdit}"
                                    ToolTipService.ToolTip="Delete folder"
                                    automation:AutomationProperties.Name="Delete folder" />
                            </Grid>

                            <!-- Rename row -->
                            <StackPanel Spacing="4" Visibility="{x:Bind IsRenaming, Mode=OneWay}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="RenameBox"
                                        Grid.Column="0"
                                        KeyDown="OnRenameKeyDown"
                                        Text="{x:Bind EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        automation:AutomationProperties.Name="Folder name" />
                                    <Button
                                        Grid.Column="1"
                                        Click="OnCommitRenameClick"
                                        Content="Save"
                                        ToolTipService.ToolTip="Save the new name (Enter)"
                                        automation:AutomationProperties.Name="Save folder name" />
                                    <Button
                                        Grid.Column="2"
                                        Click="OnCancelRenameClick"
                                        Content="Cancel"
                                        ToolTipService.ToolTip="Cancel renaming (Esc)"
                                        automation:AutomationProperties.Name="Cancel rename" />
                                </Grid>
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{x:Bind RenameError, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Visibility="{x:Bind RenameError, Mode=OneWay, Converter={StaticResource HasTextVisible}}"
                                    automation:AutomationProperties.LiveSetting="Assertive" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
                <!-- Shown when there are no user folders; the built-in Unfiled row is always listed above. -->
                <TextBlock
                    Margin="8,4"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.EmptyState}"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                <TextBlock
                    Margin="8,4"
                    Opacity="0.7"
                    Text="{x:Bind ViewModel.DeleteNote}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
