<Application
    x:Class="SmartSnippets.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Design tokens (plan 009 T7). Inlined here rather than a separate ms-appx dictionary: the unpackaged app uses no ms-appx URIs elsewhere. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="FolderTintBrush" Color="#B8A4F0" />
                    <SolidColorBrush x:Key="FolderTintBackgroundBrush" Color="#2E2650" />
                    <SolidColorBrush x:Key="AccentTintBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#C4463D" />
                    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FolderTintBrush" Color="#6B4FBB" />
                    <SolidColorBrush x:Key="FolderTintBackgroundBrush" Color="#EFEAFB" />
                    <SolidColorBrush x:Key="AccentTintBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
                    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="DangerForegroundBrush" Color="#FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="FolderTintBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="FolderTintBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AccentTintBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DangerBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="DangerBackgroundBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="DangerForegroundBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="{ThemeResource DangerBackgroundBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource DangerForegroundBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
