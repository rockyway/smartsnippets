<Project>
  <Import Project="Sdk.props" Sdk="Uno.Sdk" Version="6.7.30" />
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationTitle>Smart Snippets — Uno candidate</ApplicationTitle>
    <ApplicationId>org.smartsnippets.unoacceptancefixture019</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <AssemblyName>SmartSnippets.UnoAcceptanceFixture</AssemblyName>
    <RootNamespace>SmartSnippets.Uno</RootNamespace>
    <DisableImplicitUnoPackages>true</DisableImplicitUnoPackages>
    <ImplicitUsings>disable</ImplicitUsings>
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platform>x64</Platform><Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>../../src/SmartSnippets.Uno/app.manifest</ApplicationManifest>
    <ApplicationIcon>../../src/SmartSnippets.Uno/Assets/SmartSnippets.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>SmartSnippets.Uno.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot><PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer><EnableAotAnalyzer>true</EnableAotAnalyzer>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <ProjectReference Include="../../src/SmartSnippets.Core/SmartSnippets.Core.csproj" />
    <ProjectReference Include="../../src/SmartSnippets.Presentation/SmartSnippets.Presentation.csproj" />
    <Compile Include="Program.cs;App.xaml.cs;../../tests/SmartSnippets.Uno.Tests/Acceptance/CandidateAcceptanceFlow.cs;../../tests/SmartSnippets.Uno.Tests/Acceptance/UiAssertDriver.cs" />
    <Compile Include="../../src/SmartSnippets.Uno/**/*.cs" Exclude="../../src/SmartSnippets.Uno/bin/**;../../src/SmartSnippets.Uno/obj/**;../../src/SmartSnippets.Uno/Program.cs;../../src/SmartSnippets.Uno/App.xaml.cs" LinkBase="Candidate" />
    <ApplicationDefinition Include="../../src/SmartSnippets.Uno/App.xaml" Link="App.xaml" />
    <Page Include="../../src/SmartSnippets.Uno/**/*.xaml" Exclude="../../src/SmartSnippets.Uno/App.xaml;../../src/SmartSnippets.Uno/bin/**;../../src/SmartSnippets.Uno/obj/**" LinkBase="Candidate" />
    <AdditionalFiles Include="../../src/SmartSnippets.Uno/NativeMethods.txt;../../src/SmartSnippets.Uno/NativeMethods.json" />
    <Content Include="../../src/SmartSnippets.Uno/Assets/*" Link="Assets/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../src/SmartSnippets.Uno/Platforms/Windows/AcceptanceNative/AcceptanceNative.links.projitems" />
  <Import Project="Sdk.targets" Sdk="Uno.Sdk" Version="6.7.30" />
  <PropertyGroup>
    <!-- Remove the inherited ILLink IL2121 suppression after all SDK imports. -->
    <NoWarn></NoWarn>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
