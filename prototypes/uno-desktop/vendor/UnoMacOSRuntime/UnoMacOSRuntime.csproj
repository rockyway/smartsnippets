<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Uno.UI.Runtime.Skia.MacOS</AssemblyName>
    <RootNamespace>Uno.UI.Runtime.Skia.MacOS</RootNamespace>
    <AssemblyVersion>255.255.255.255</AssemblyVersion>
    <FileVersion>6.7.135.0</FileVersion>
    <Version>6.7.135-probe018</Version>
    <PublishAot>false</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);UNO_REFERENCE_API;HAS_UNO_SKIA</DefineConstants>
    <UnoRuntimeIdentifier>Skia</UnoRuntimeIdentifier>
    <UnoMacOSSourceRoot Condition="'$(UnoMacOSSourceRoot)' == ''">$(MSBuildThisFileDirectory)../obj/upstream</UnoMacOSSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnoMacOSSourceRoot)/src/Uno.UI.Runtime.Skia.MacOS/**/*.cs" />
    <!-- Upstream references implementation projects, not the app-consumer analyzer
         package. Keep SDK trim/AOT analyzers enabled for this source build. -->
    <PackageReference Include="Uno.WinUI" Version="6.7.135" GeneratePathProperty="true" ExcludeAssets="analyzers" />
    <PackageReference Include="Uno.Foundation" Version="6.7.135" GeneratePathProperty="true" />
    <PackageReference Include="Uno.WinRT" Version="6.7.135" GeneratePathProperty="true" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia" Version="6.7.135" />
    <PackageReference Include="Uno.WinUI.Runtime.Skia.Linux.FrameBuffer" Version="6.7.135" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.1" />
  </ItemGroup>
  <!-- Upstream co-builds this friend assembly against Skia implementations, not
       the portable public API facades NuGet otherwise selects for net10.0. -->
  <Target Name="UsePinnedSkiaImplementationReferences" BeforeTargets="FindReferenceAssembliesForReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Uno.WinUI' OR '%(ReferencePath.NuGetPackageId)' == 'Uno.Foundation' OR '%(ReferencePath.NuGetPackageId)' == 'Uno.WinRT'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Uno.WinUI' OR '%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Uno.Foundation' OR '%(ReferenceCopyLocalPaths.NuGetPackageId)' == 'Uno.WinRT'" />
      <_SkiaImplementation Include="$(PkgUno_WinUI)/uno-runtime/net10.0/skia/*.dll;$(PkgUno_Foundation)/uno-runtime/net10.0/skia/*.dll;$(PkgUno_WinRT)/uno-runtime/net10.0/skia/*.dll" />
      <ReferencePath Include="@(_SkiaImplementation)" />
      <ReferenceCopyLocalPaths Include="@(_SkiaImplementation)" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveAppConsumerOnlyAnalyzer" BeforeTargets="CoreCompile">
    <!-- Also flows transitively through Uno.WinRT/Foundation; this backend
         implements the annotated APIs. App projects retain this analyzer. -->
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'Uno.Analyzers'" />
    </ItemGroup>
  </Target>
  <Target Name="VerifyPreparedSource" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_SourcePython Condition="'$(OS)' == 'Windows_NT'">python</_SourcePython>
      <_SourcePython Condition="'$(OS)' != 'Windows_NT'">python3</_SourcePython>
    </PropertyGroup>
    <Exec Command="&quot;$(_SourcePython)&quot; &quot;$(MSBuildThisFileDirectory)../prepare_source.py&quot; --verify --output &quot;$(UnoMacOSSourceRoot)&quot;" />
  </Target>
</Project>
