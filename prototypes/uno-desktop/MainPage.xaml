<Page
    x:Class="SmartSnippets.UnoProbe.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="24" Spacing="12">
        <TextBlock Text="Smart Snippets — isolated feasibility probe" />
        <TextBox x:Name="LabelEditor" AutomationProperties.AutomationId="OwnedCompanionLeave" Header="Synthetic label" Text="{x:Bind Label, Mode=TwoWay}" FontSize="{x:Bind EditorSize, Mode=OneWay}" />
        <TextBox x:Name="BodyEditor" Header="Synthetic text" AcceptsReturn="True" Text="{x:Bind Body, Mode=TwoWay}" FontSize="{x:Bind EditorSize, Mode=OneWay}" />
        <TextBlock Text="No clipboard, shortcut registration, startup changes or insertion are enabled." TextWrapping="Wrap" />
        <Border x:Name="CompanionRow" Visibility="Collapsed" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Padding="12">
            <TextBlock Text="Synthetic hover details" AutomationProperties.AutomationId="OwnedCompanionRow" />
        </Border>
    </StackPanel>
</Page>
