<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.26100;net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Smart Snippets Feasibility Probe</ApplicationTitle>
    <ApplicationId>org.smartsnippets.feasibility018</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>SmartSnippets</ApplicationPublisher>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <!-- Explicitly exclude development servers/design tools from this offline probe. -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WinAppSdkVersion>1.8.260921001</WinAppSdkVersion>
    <WinAppSdkBuildToolsVersion>10.0.28000.2705</WinAppSdkBuildToolsVersion>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Diagnostic only: test the documented manual-package path, not an IL suppression. -->
    <DisableImplicitUnoPackages Condition="'$(ProbeManualWindowsPackages)' == 'true'">true</DisableImplicitUnoPackages>
    <!-- Uno.Sdk otherwise injects a global using Uno.UI even in manual mode. -->
    <ImplicitUsings Condition="'$(ProbeManualWindowsPackages)' == 'true'">disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' AND '$(ProbeManualWindowsPackages)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(WinAppSdkBuildToolsVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SmartSnippets.Core/SmartSnippets.Core.csproj" />
    <ProjectReference Include="../../src/SmartSnippets.Presentation/SmartSnippets.Presentation.csproj" />
  </ItemGroup>
</Project>
