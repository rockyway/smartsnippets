<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.26100;net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Smart Snippets Feasibility Probe</ApplicationTitle>
    <ApplicationId>org.smartsnippets.feasibility018</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>SmartSnippets</ApplicationPublisher>
    <UnoFeatures>SkiaRenderer;</UnoFeatures>
    <!-- Explicitly exclude development servers/design tools from this offline probe. -->
    <UnoDisableHotDesign>true</UnoDisableHotDesign>
    <UnoDisableMCPSupport>true</UnoDisableMCPSupport>
    <DefaultLanguage>en-US</DefaultLanguage>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishSingleFile>false</PublishSingleFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);vendor/**;macos-json-risk/**;macos-pasteboard-risk/**;mobile-risk/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <!-- Preserve the existing product's Windows 1809 build floor; Uno's
         default 18362 must not silently raise it during a migration probe. -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <WinAppSdkVersion>1.8.260921001</WinAppSdkVersion>
    <WinAppSdkBuildToolsVersion>10.0.28000.2705</WinAppSdkBuildToolsVersion>
    <Platform>x64</Platform>
    <Platforms>x64</Platforms>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>SmartSnippets.UnoProbe.WindowsProgram</StartupObject>
    <!-- Diagnostic only: test the documented manual-package path, not an IL suppression. -->
    <DisableImplicitUnoPackages Condition="'$(ProbeManualWindowsPackages)' == 'true'">true</DisableImplicitUnoPackages>
    <!-- Uno.Sdk otherwise injects a global using Uno.UI even in manual mode. -->
    <ImplicitUsings Condition="'$(ProbeManualWindowsPackages)' == 'true'">disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' AND '$(ProbeManualWindowsPackages)' == 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="$(WinAppSdkVersion)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(WinAppSdkBuildToolsVersion)" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'desktop'">
    <UnoIcon Include="Assets/Icons/icon.svg" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'desktop' AND '$(ProbePatchedMacOSRuntime)' == 'true'">
    <ProjectReference Include="vendor/UnoMacOSRuntime/UnoMacOSRuntime.csproj" />
  </ItemGroup>
  <Target Name="SelectSourceBuiltMacOSRuntime" AfterTargets="UnoImplicitPackages"
          Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'desktop' AND '$(ProbePatchedMacOSRuntime)' == 'true'">
    <ItemGroup>
      <!-- Retain the published native host/build assets; only managed code is
           replaced by the source-built project, never patched in the cache. -->
      <_OriginalMacOSPackage Include="@(PackageReference)" Condition="'%(PackageReference.Identity)' == 'Uno.WinUI.Runtime.Skia.MacOS'" />
      <PackageReference Remove="@(_OriginalMacOSPackage)" />
      <PackageReference Include="@(_OriginalMacOSPackage)">
        <ExcludeAssets>compile;runtime</ExcludeAssets>
      </PackageReference>
      <_OriginalMacOSPackage Remove="@(_OriginalMacOSPackage)" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- Standalone serializer investigation is not source for the Uno application. -->
    <Compile Remove="macos-json-risk/**/*.cs;tests/**/*.cs" />
    <ProjectReference Include="../../src/SmartSnippets.Core/SmartSnippets.Core.csproj" />
    <ProjectReference Include="../../src/SmartSnippets.Presentation/SmartSnippets.Presentation.csproj" />
  </ItemGroup>
</Project>
