<UserControl
    x:Class="SmartSnippets.UnoProbe.CompanionProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PointerSurface" Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <ScrollViewer x:Name="Scroller" AutomationProperties.AutomationId="OwnedCompanionSurface" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="Body" Text="{x:Bind Details}" FontSize="16" TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</UserControl>
