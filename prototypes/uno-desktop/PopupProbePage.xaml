<Page
    x:Class="SmartSnippets.UnoProbe.PopupProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SmartSnippets.UnoProbe">
    <Grid x:Name="PaletteSurface" Background="{ThemeResource ProbePaletteBackground}" Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchEditor" PlaceholderText="Find synthetic snippet" Text="{x:Bind Query, Mode=TwoWay}" />
        <ListView x:Name="RowsView" Grid.Row="1" ItemsSource="{x:Bind Rows}" SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:ProbeRow">
                    <StackPanel Padding="8" Spacing="4">
                        <TextBlock Text="{x:Bind Label}" FontSize="{x:Bind TextSize}" />
                        <TextBlock Text="{x:Bind Preview}" MaxLines="2" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <TextBlock Grid.Row="2" Text="Target-free fixture: no insertion or clipboard adapter is connected." TextWrapping="Wrap" />
    </Grid>
</Page>
