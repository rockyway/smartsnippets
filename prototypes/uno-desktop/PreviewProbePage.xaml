<Page
    x:Class="SmartSnippets.UnoProbe.PreviewProbePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SmartSnippets.Presentation.ViewModels">
    <Grid Padding="16" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBox x:Name="SearchEditor" Text="{x:Bind Model.Query, Mode=TwoWay}" KeyDown="SearchKeyDown" PlaceholderText="Target-free native Enter fixture" />
        <ListView x:Name="RowsView" Grid.Row="1" ItemsSource="{x:Bind Model.Items, Mode=OneWay}"
                  SelectedIndex="{x:Bind Model.SelectedIndex, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PopupItemViewModel">
                    <StackPanel Padding="8">
                        <TextBlock Text="{x:Bind Label}" />
                        <TextBlock Text="{x:Bind Details}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
