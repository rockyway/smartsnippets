<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SmartSnippets.UnoCandidate.Guardian</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot><PublishTrimmed>true</PublishTrimmed><IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer><EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings><TrimmerSingleWarn>false</TrimmerSingleWarn>
    <NoWarn></NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SmartSnippets.Presentation/SmartSnippets.Presentation.csproj" />
    <Compile Include="../../src/SmartSnippets.Uno/Platforms/Windows/CandidateNativeCapability.cs" Link="CandidateContract/CandidateNativeCapability.cs" />
    <Compile Include="../../src/SmartSnippets.Uno/Platforms/Windows/AcceptanceNative/*.cs" Link="AcceptanceNative/%(Filename)%(Extension)" />
    <Compile Include="../uno-native-target/windows-insertion/GuardianWindow.cs" Link="AcceptancePrerequisites/GuardianWindow.cs" />
  </ItemGroup>
  <Import Project="../../src/SmartSnippets.Uno/Platforms/Windows/AcceptanceNative/AcceptanceNative.links.projitems" />
  <Target Name="RequireStrictGuardian" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NoWarn)' != '' Or '$(PublishAot)' != 'true' Or '$(PublishTrimmed)' != 'true' Or '$(IsAotCompatible)' != 'true' Or '$(TreatWarningsAsErrors)' != 'true' Or '$(SuppressTrimAnalysisWarnings)' != 'false' Or '$(TrimmerSingleWarn)' != 'false'" Text="Guardian requires strict Native AOT with no suppressed warnings. Pass -p:NoWarn= explicitly." />
  </Target>
</Project>
